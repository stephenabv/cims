{
  "name": "cims",
  "private": true,
  "description": "Company Information Management System",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter @cims/shared build && pnpm -r --filter !@cims/shared build",
    "dev:api": "pnpm --filter @cims/api dev",
    "dev:web": "pnpm --filter @cims/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @cims/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @cims/shared build && pnpm -r test",
    "db:up": "docker compose up -d postgres mailpit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.5.0",
      "deepmerge-ts": "8.0.2"
    }
  }
}
