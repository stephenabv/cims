{
  "name": "@cims/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@cims/shared": "workspace:*",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@nestjs/schedule": "5.0.1",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.0",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "luxon": "3.7.2",
    "nestjs-pino": "4.4.1",
    "nodemailer": "6.10.1",
    "otplib": "12.0.1",
    "pino": "9.13.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.9",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/luxon": "3.7.1",
    "@types/node": "22.18.0",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "tsc-watch": "6.3.1"
  }
}
