# --- Runtime ---
# Vercel deployment: see docs/DEPLOYMENT_VERCEL.md (WEB_ORIGIN, TRUST_PROXY_HOPS and COOKIE_SECURE are derived there).
NODE_ENV=development
PORT=3000
# Public origin of the web client (CORS + cookie scope)
WEB_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://cims:cims_dev_password@localhost:5432/cims?schema=public

# --- Security ---
# 32+ random bytes, base64. Used to sign CSRF tokens. Generate: openssl rand -base64 48
CSRF_SECRET=change-me-change-me-change-me-change-me-change-me
# Encrypts TOTP secrets at rest (AES-256-GCM). Exactly 32 bytes, base64. Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Set to true when served over HTTPS (production must be true)
COOKIE_SECURE=false

# --- Bootstrap IT administrator (used only by the seed when no IT admin exists) ---
BOOTSTRAP_ADMIN_EMAIL=it.admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- Mail (dev: mailpit at localhost:1025, UI on :8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CIMS <no-reply@example.com>"
