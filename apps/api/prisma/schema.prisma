// CIMS database schema. Conventions: snake_case tables/columns, UUID primary keys,
// created_at/updated_at on every mutable table, timestamptz for instants.
// See docs/SYSTEM_ARCHITECTURE.md §4.

generator client {
  provider      = "prisma-client-js"
  // "native" for local/CI builds; rhel-openssl-3.0.x is the Vercel Functions runtime (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Access control ─────────────────────────────

model Role {
  id                 String              @id @default(uuid()) @db.Uuid
  key                String              @unique @db.VarChar(50)
  name               String              @db.VarChar(100)
  description        String?             @db.VarChar(500)
  /// System roles cannot be deleted or renamed (their permissions remain editable).
  isSystem           Boolean             @default(false) @map("is_system")
  /// Holders must enrol and use TOTP 2FA (spec §3.9, §5).
  requiresMfa        Boolean             @default(false) @map("requires_mfa")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions        RolePermission[]
  users              UserAccount[]
  approvalChainSteps ApprovalChainStep[]
  leaveApprovalSteps LeaveApprovalStep[]

  @@map("role")
}

model Permission {
  code        String           @id @db.VarChar(100)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(100)
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@index([permissionCode])
  @@map("role_permission")
}

// ───────────────────────────── Organisation ─────────────────────────────

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(20)
  name      String     @unique @db.VarChar(100)
  /// Executive/manager responsible for the department (scopes `*.department` permissions).
  headId    String?    @map("head_id") @db.Uuid
  head      Employee?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  employees Employee[] @relation("DepartmentMembers")
  positions Position[]

  @@map("department")
}

model Position {
  id           String      @id @default(uuid()) @db.Uuid
  title        String      @db.VarChar(100)
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  employees    Employee[]

  @@unique([title, departmentId])
  @@map("position")
}

enum EmploymentClassification {
  REGULAR
  PROBATIONARY
  CONTRACTUAL
  PROJECT_BASED
  PART_TIME
  INTERN

  @@map("employment_classification")
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  RETIRED

  @@map("employment_status")
}

model Employee {
  id                           String                   @id @default(uuid()) @db.Uuid
  /// Permanent, system-assigned identifier (EMP-000123). Never editable (BR-1).
  accountNumber                String                   @unique @map("account_number") @db.VarChar(20)
  firstName                    String                   @map("first_name") @db.VarChar(100)
  middleName                   String?                  @map("middle_name") @db.VarChar(100)
  lastName                     String                   @map("last_name") @db.VarChar(100)
  suffix                       String?                  @db.VarChar(20)
  /// Approved company email only (BR-6). Stored lower-case.
  companyEmail                 String                   @unique @map("company_email") @db.VarChar(254)
  contactNumber                String?                  @map("contact_number") @db.VarChar(30)
  residentialAddress           String?                  @map("residential_address") @db.VarChar(500)
  emergencyContactName         String?                  @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactRelationship String?                  @map("emergency_contact_relationship") @db.VarChar(50)
  emergencyContactPhone        String?                  @map("emergency_contact_phone") @db.VarChar(30)
  departmentId                 String?                  @map("department_id") @db.Uuid
  department                   Department?              @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  positionId                   String?                  @map("position_id") @db.Uuid
  position                     Position?                @relation(fields: [positionId], references: [id], onDelete: SetNull)
  /// Immediate supervisor / designated approver (§3.3).
  supervisorId                 String?                  @map("supervisor_id") @db.Uuid
  supervisor                   Employee?                @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates                 Employee[]               @relation("Supervision")
  classification               EmploymentClassification @default(PROBATIONARY)
  employmentStatus             EmploymentStatus         @default(ACTIVE) @map("employment_status")
  dateHired                    DateTime                 @map("date_hired") @db.Date
  /// Optimistic concurrency token.
  version                      Int                      @default(1)
  createdById                  String?                  @map("created_by_id") @db.Uuid
  createdAt                    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Null = company default schedule.
  workScheduleId               String?                  @map("work_schedule_id") @db.Uuid
  workSchedule                 WorkSchedule?            @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  account                      UserAccount?
  attendanceEvents             AttendanceEvent[]
  attendanceDays               AttendanceDay[]
  attendanceConflicts          AttendanceConflict[]
  headOfDepartments            Department[]             @relation("DepartmentHead")
  changeHistory                EmployeeChangeHistory[]
  leaveRequests                LeaveRequest[]
  leaveRequestDays             LeaveRequestDay[]
  leaveBalances                LeaveBalance[]
  approvalChainSteps           ApprovalChainStep[]
  overtimeRecords              OvertimeRecord[]
  compensationProfiles         CompensationProfile[]
  payItems                     EmployeePayItem[]
  leaveApprovalSteps           LeaveApprovalStep[]

  @@index([departmentId])
  @@index([supervisorId])
  @@index([lastName, firstName])
  @@map("employee")
}

model EmployeeChangeHistory {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  field       String   @db.VarChar(100)
  oldValue    String?  @map("old_value") @db.Text
  newValue    String?  @map("new_value") @db.Text
  changedById String?  @map("changed_by_id") @db.Uuid
  reason      String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([employeeId, createdAt])
  @@map("employee_change_history")
}

// ───────────────────────────── Accounts & sessions ─────────────────────────────

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

model UserAccount {
  id                    String               @id @default(uuid()) @db.Uuid
  employeeId            String               @unique @map("employee_id") @db.Uuid
  employee              Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  roleId                String               @map("role_id") @db.Uuid
  role                  Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status                AccountStatus        @default(PENDING_ACTIVATION)
  passwordHash          String               @map("password_hash") @db.VarChar(255)
  passwordChangedAt     DateTime             @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword    Boolean              @default(true) @map("must_change_password")
  /// Set while the current password is a temporary one (BR-7).
  tempPasswordExpiresAt DateTime?            @map("temp_password_expires_at") @db.Timestamptz(3)
  failedLoginCount      Int                  @default(0) @map("failed_login_count")
  lockedUntil           DateTime?            @map("locked_until") @db.Timestamptz(3)
  lastLoginAt           DateTime?            @map("last_login_at") @db.Timestamptz(3)
  pinHash               String               @map("pin_hash") @db.VarChar(255)
  pinChangedAt          DateTime             @default(now()) @map("pin_changed_at") @db.Timestamptz(3)
  failedPinCount        Int                  @default(0) @map("failed_pin_count")
  pinLockedUntil        DateTime?            @map("pin_locked_until") @db.Timestamptz(3)
  /// AES-256-GCM encrypted TOTP secret (base64 iv:tag:ciphertext).
  mfaSecretEnc          String?              @map("mfa_secret_enc") @db.VarChar(512)
  mfaEnabledAt          DateTime?            @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time-step; prevents replay of the same code.
  mfaLastStep           BigInt?              @map("mfa_last_step")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions              Session[]
  resetTokens           PasswordResetToken[]
  recoveryCodes         MfaRecoveryCode[]
  authEvents            AuthEvent[]

  @@index([roleId])
  @@map("user_account")
}

model Session {
  id            String      @id @default(uuid()) @db.Uuid
  /// SHA-256 of the opaque cookie token; the raw token is never stored.
  tokenHash     String      @unique @map("token_hash") @db.Char(64)
  userId        String      @map("user_id") @db.Uuid
  user          UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// False while a password-authenticated session still awaits the 2FA step.
  mfaVerified   Boolean     @default(false) @map("mfa_verified")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry regardless of activity.
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?     @map("revoked_reason") @db.VarChar(100)
  ip            String?     @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.VarChar(512)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model PasswordResetToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?   @map("used_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_token")
}

model MfaRecoveryCode {
  id       String      @id @default(uuid()) @db.Uuid
  userId   String      @map("user_id") @db.Uuid
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String      @map("code_hash") @db.Char(64)
  usedAt   DateTime?   @map("used_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("mfa_recovery_code")
}

// ───────────────────────────── Audit ─────────────────────────────

enum AuthEventType {
  LOGIN
  LOGOUT
  MFA_CHALLENGE
  MFA_ENROLLED
  MFA_DISABLED
  PASSWORD_CHANGED
  PASSWORD_RECOVERY_REQUESTED
  PASSWORD_RECOVERY_COMPLETED
  TEMP_PASSWORD_ISSUED
  PIN_CHANGED
  PIN_RESET
  ACCOUNT_LOCKED
  PIN_VERIFY
  SESSION_REVOKED

  @@map("auth_event_type")
}

model AuthEvent {
  id            String        @id @default(uuid()) @db.Uuid
  type          AuthEventType
  success       Boolean
  userId        String?       @map("user_id") @db.Uuid
  user          UserAccount?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Identifier as typed by the requester (kept even when no account matches).
  accountNumber String?       @map("account_number") @db.VarChar(50)
  reason        String?       @db.VarChar(100)
  ip            String?       @db.VarChar(64)
  userAgent     String?       @map("user_agent") @db.VarChar(512)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([accountNumber, createdAt])
  @@map("auth_event")
}

/// Append-only log of sensitive actions. Never contains secrets.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?  @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ───────────────────────────── Settings ─────────────────────────────

/// Typed key/value company configuration; keys and value schemas are defined in SettingsService.
model CompanySetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("company_setting")
}

// ───────────────────────────── Schedules ─────────────────────────────

/// Expected working pattern used to derive late/undertime/overtime/absence (assumption A-1).
model WorkSchedule {
  id                    String            @id @default(uuid()) @db.Uuid
  name                  String            @unique @db.VarChar(100)
  /// Exactly one schedule is the company default (enforced by a partial unique index).
  isDefault             Boolean           @default(false) @map("is_default")
  /// Minutes after the scheduled start before an arrival counts as late.
  graceMinutes          Int               @default(15) @map("grace_minutes")
  /// Unpaid break deducted from days worked for at least `breakThresholdMinutes`.
  breakMinutes          Int               @default(60) @map("break_minutes")
  breakThresholdMinutes Int               @default(240) @map("break_threshold_minutes")
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  days                  WorkScheduleDay[]
  employees             Employee[]

  @@map("work_schedule")
}

/// One row per working weekday; weekdays without a row are rest days.
model WorkScheduleDay {
  scheduleId  String       @map("schedule_id") @db.Uuid
  schedule    WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /// ISO weekday: 1 = Monday … 7 = Sunday.
  weekday     Int          @db.SmallInt
  /// Minutes after local midnight, company timezone.
  startMinute Int          @map("start_minute") @db.SmallInt
  endMinute   Int          @map("end_minute") @db.SmallInt

  @@id([scheduleId, weekday])
  @@map("work_schedule_day")
}

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("holiday")
}

// ───────────────────────────── Attendance ─────────────────────────────

/// Attendance terminal registered by IT. Only the SHA-256 of its token is stored.
model KioskDevice {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(100)
  tokenHash   String            @unique @map("token_hash") @db.Char(64)
  createdById String?           @map("created_by_id") @db.Uuid
  lastSeenAt  DateTime?         @map("last_seen_at") @db.Timestamptz(3)
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  events      AttendanceEvent[]
  syncBatches SyncBatch[]

  @@map("kiosk_device")
}

enum AttendanceEventType {
  TIME_IN
  TIME_OUT

  @@map("attendance_event_type")
}

enum AttendanceEventSource {
  KIOSK_ONLINE
  KIOSK_OFFLINE
  ADJUSTMENT

  @@map("attendance_event_source")
}

enum AttendanceEventStatus {
  ACCEPTED
  /// Kept for audit but excluded from computation (HR correction).
  VOIDED
  /// Offline record that contradicts existing data; awaits HR review (§4).
  CONFLICT

  @@map("attendance_event_status")
}

/// Raw punches. Never deleted or edited in place; corrections void and re-add (§4 originals preserved).
model AttendanceEvent {
  id          String                @id @default(uuid()) @db.Uuid
  employeeId  String                @map("employee_id") @db.Uuid
  employee    Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  type        AttendanceEventType
  /// When the punch happened (server time online; device time offline, validated).
  occurredAt  DateTime              @map("occurred_at") @db.Timestamptz(3)
  /// When the server stored it.
  recordedAt  DateTime              @default(now()) @map("recorded_at") @db.Timestamptz(3)
  /// Business date (company timezone) the punch belongs to; a time-out inherits its time-in's date.
  workDate    DateTime              @map("work_date") @db.Date
  source      AttendanceEventSource
  status      AttendanceEventStatus @default(ACCEPTED)
  deviceId    String?               @map("device_id") @db.Uuid
  device      KioskDevice?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// Client-generated id for idempotent offline sync.
  clientUuid  String?               @unique @map("client_uuid") @db.Uuid
  createdById String?               @map("created_by_id") @db.Uuid
  note        String?               @db.VarChar(500)
  voidedById  String?               @map("voided_by_id") @db.Uuid
  voidedAt    DateTime?             @map("voided_at") @db.Timestamptz(3)
  voidReason  String?               @map("void_reason") @db.VarChar(500)
  conflict    AttendanceConflict?

  @@index([employeeId, occurredAt])
  @@index([employeeId, workDate])
  @@index([workDate])
  @@map("attendance_event")
}

enum AttendanceDayStatus {
  PRESENT
  LATE
  INCOMPLETE
  REST_DAY_WORKED
  HOLIDAY_WORKED

  @@map("attendance_day_status")
}

/// Derived daily totals, recomputed from accepted events whenever they change.
model AttendanceDay {
  id               String              @id @default(uuid()) @db.Uuid
  employeeId       String              @map("employee_id") @db.Uuid
  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workDate         DateTime            @map("work_date") @db.Date
  firstIn          DateTime?           @map("first_in") @db.Timestamptz(3)
  lastOut          DateTime?           @map("last_out") @db.Timestamptz(3)
  workedMinutes    Int                 @default(0) @map("worked_minutes")
  regularMinutes   Int                 @default(0) @map("regular_minutes")
  lateMinutes      Int                 @default(0) @map("late_minutes")
  undertimeMinutes Int                 @default(0) @map("undertime_minutes")
  overtimeMinutes  Int                 @default(0) @map("overtime_minutes")
  scheduledMinutes Int                 @default(0) @map("scheduled_minutes")
  status           AttendanceDayStatus
  hasOpenPunch     Boolean             @default(false) @map("has_open_punch")
  computedAt       DateTime            @default(now()) @map("computed_at") @db.Timestamptz(3)

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@map("attendance_day")
}

// ─── Offline attendance sync (§4) ─────────────────────────────────────────────

/// RSA-OAEP key pair kiosks use to encrypt offline credentials. Only the public key leaves the server;
/// the private key is stored encrypted with DATA_ENCRYPTION_KEY. One key is active at a time.
model KioskSyncKey {
  id            String    @id @default(uuid()) @db.Uuid
  publicKeySpki String    @map("public_key_spki") @db.Text
  privateKeyEnc String    @map("private_key_enc") @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(3)

  @@map("kiosk_sync_key")
}

/// One upload of a kiosk's offline outbox, with per-outcome counts.
model SyncBatch {
  id         String      @id @default(uuid()) @db.Uuid
  deviceId   String      @map("device_id") @db.Uuid
  device     KioskDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  receivedAt DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)
  itemCount  Int         @map("item_count")
  applied    Int
  duplicates Int
  conflicts  Int
  rejected   Int
  deferred   Int

  @@index([deviceId, receivedAt])
  @@map("sync_batch")
}

enum AttendanceConflictStatus {
  OPEN
  ACCEPTED
  REJECTED

  @@map("attendance_conflict_status")
}

/// An offline punch that contradicts existing records; HR accepts or rejects it (never silently applied).
model AttendanceConflict {
  id             String                   @id @default(uuid()) @db.Uuid
  eventId        String                   @unique @map("event_id") @db.Uuid
  event          AttendanceEvent          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  employeeId     String                   @map("employee_id") @db.Uuid
  employee       Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reason         String                   @db.VarChar(40)
  status         AttendanceConflictStatus @default(OPEN)
  resolvedById   String?                  @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?                @map("resolved_at") @db.Timestamptz(3)
  resolutionNote String?                  @map("resolution_note") @db.VarChar(500)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("attendance_conflict")
}

// ─── Leave (spec §3.3) ─────────────────────────────────────────────────────────

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Cancelled by HR (e.g. approved leave revoked before it starts) — assumption A-4.
  CANCELLED
  /// Pulled back by the employee before any approver acted — assumption A-4.
  WITHDRAWN

  @@map("leave_request_status")
}

enum ApprovalStepKind {
  /// The employee's immediate supervisor.
  SUPERVISOR
  /// Head of the employee's department.
  DEPARTMENT_HEAD
  /// Any active user holding the role (and the leave.approve permission).
  ROLE
  /// A specific named employee.
  EMPLOYEE

  @@map("approval_step_kind")
}

enum LeaveStepStatus {
  /// Later step; becomes PENDING when the previous one approves.
  WAITING
  PENDING
  APPROVED
  REJECTED
  /// Could not be resolved (e.g. no supervisor) or would have the applicant approve themselves.
  SKIPPED
  /// Request ended (rejected, withdrawn, cancelled) before this step acted.
  CANCELLED

  @@map("leave_step_status")
}

model LeaveType {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique @db.VarChar(20)
  name            String         @unique @db.VarChar(100)
  /// Paid leave counts as paid hours in payroll (assumption A-9).
  isPaid          Boolean        @default(true) @map("is_paid")
  isActive        Boolean        @default(true) @map("is_active")
  /// Null = the default approval chain.
  approvalChainId String?        @map("approval_chain_id") @db.Uuid
  approvalChain   ApprovalChain? @relation(fields: [approvalChainId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  requests        LeaveRequest[]
  balances        LeaveBalance[]

  @@map("leave_type")
}

model ApprovalChain {
  id         String              @id @default(uuid()) @db.Uuid
  name       String              @unique @db.VarChar(100)
  isDefault  Boolean             @default(false) @map("is_default")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  steps      ApprovalChainStep[]
  leaveTypes LeaveType[]

  @@map("approval_chain")
}

model ApprovalChainStep {
  id         String           @id @default(uuid()) @db.Uuid
  chainId    String           @map("chain_id") @db.Uuid
  chain      ApprovalChain    @relation(fields: [chainId], references: [id], onDelete: Cascade)
  /// 1-based order.
  position   Int
  kind       ApprovalStepKind
  roleId     String?          @map("role_id") @db.Uuid
  role       Role?            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employeeId String?          @map("employee_id") @db.Uuid
  employee   Employee?        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([chainId, position])
  @@map("approval_chain_step")
}

model LeaveRequest {
  id          String              @id @default(uuid()) @db.Uuid
  employeeId  String              @map("employee_id") @db.Uuid
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId String              @map("leave_type_id") @db.Uuid
  leaveType   LeaveType           @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate   DateTime            @map("start_date") @db.Date
  endDate     DateTime            @map("end_date") @db.Date
  /// Working days counted at submission (schedule and holidays then in force; assumption A-5).
  days        Int
  reason      String              @db.VarChar(1000)
  status      LeaveRequestStatus  @default(PENDING)
  /// Optimistic concurrency token: every state change increments it.
  version     Int                 @default(1)
  submittedAt DateTime            @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedAt   DateTime?           @map("decided_at") @db.Timestamptz(3)
  /// User who withdrew or cancelled, and why.
  endedById   String?             @map("ended_by_id") @db.Uuid
  endReason   String?             @map("end_reason") @db.VarChar(500)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  steps       LeaveApprovalStep[]
  leaveDays   LeaveRequestDay[]

  @@index([employeeId, startDate])
  @@index([status])
  @@map("leave_request")
}

/// One row per counted working day: drives balances per year, attendance (ON_LEAVE) and payroll.
model LeaveRequestDay {
  requestId  String       @map("request_id") @db.Uuid
  request    LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employeeId String       @map("employee_id") @db.Uuid
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date       DateTime     @db.Date

  @@id([requestId, date])
  @@index([employeeId, date])
  @@map("leave_request_day")
}

/// The chain resolved for one request at submission. Steps are never deleted.
model LeaveApprovalStep {
  id                 String           @id @default(uuid()) @db.Uuid
  requestId          String           @map("request_id") @db.Uuid
  request            LeaveRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  position           Int
  kind               ApprovalStepKind
  /// Resolved approver for SUPERVISOR / DEPARTMENT_HEAD / EMPLOYEE steps.
  approverEmployeeId String?          @map("approver_employee_id") @db.Uuid
  approverEmployee   Employee?        @relation(fields: [approverEmployeeId], references: [id], onDelete: Restrict)
  /// Role whose holders may act on a ROLE step.
  approverRoleId     String?          @map("approver_role_id") @db.Uuid
  approverRole       Role?            @relation(fields: [approverRoleId], references: [id], onDelete: Restrict)
  status             LeaveStepStatus
  actedById          String?          @map("acted_by_id") @db.Uuid
  actedAt            DateTime?        @map("acted_at") @db.Timestamptz(3)
  note               String?          @db.VarChar(500)

  @@unique([requestId, position])
  @@index([approverEmployeeId, status])
  @@index([approverRoleId, status])
  @@map("leave_approval_step")
}

/// Optional yearly allotment per employee and type (open question Q-1). No row = not limited.
model LeaveBalance {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId  String    @map("leave_type_id") @db.Uuid
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  year         Int
  allottedDays Int       @map("allotted_days")
  updatedById  String?   @map("updated_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balance")
}

// ───────────────────────────── Overtime (§3.4, §3.6) ─────────────────────────────

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
  /// Overtime vanished after a decision (attendance corrected); kept for its history.
  VOIDED

  @@map("overtime_status")
}

enum OvertimeAction {
  APPROVE
  REJECT
  /// System: attendance changed after a decision, so the record needs a new one.
  REOPEN
  /// System: the day no longer has overtime.
  VOID

  @@map("overtime_action")
}

/// One per employee and work date with overtime at or above the company minimum. Kept in step
/// with attendance_day by AttendanceDayService; only APPROVED minutes are payable (BR-13).
model OvertimeRecord {
  id              String            @id @default(uuid()) @db.Uuid
  employeeId      String            @map("employee_id") @db.Uuid
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workDate        DateTime          @map("work_date") @db.Date
  actualMinutes   Int               @map("actual_minutes")
  approvedMinutes Int?              @map("approved_minutes")
  status          OvertimeStatus    @default(PENDING)
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  history         OvertimeHistory[]

  @@unique([employeeId, workDate])
  @@index([workDate, status])
  @@map("overtime_record")
}

/// Append-only trail of decisions and system changes on an overtime record (§3.6).
model OvertimeHistory {
  id        String         @id @default(uuid()) @db.Uuid
  recordId  String         @map("record_id") @db.Uuid
  record    OvertimeRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  action    OvertimeAction
  minutes   Int?
  note      String?        @db.VarChar(500)
  /// User account that acted; null for system changes.
  actedById String?        @map("acted_by_id") @db.Uuid
  actedAt   DateTime       @default(now()) @map("acted_at") @db.Timestamptz(3)

  @@index([recordId, actedAt])
  @@map("overtime_history")
}

// ───────────────────────────── Payroll setup (§3.4) ─────────────────────────────
// Money is stored as integer centavos (PHP); rates never use floating point.

enum UndertimePolicyKind {
  /// Missed minutes × hourly rate ÷ 60.
  HOURLY_EQUIVALENT
  /// A fixed amount per block of minutes (e.g. ₱50 per 30 minutes).
  FIXED_PER_BLOCK
  /// A company table: the first tier whose limit covers the day's minutes.
  TIERED

  @@map("undertime_policy_kind")
}

/// Company-defined undertime deduction rules; each compensation profile points at one.
model UndertimePolicy {
  id                     String                @id @default(uuid()) @db.Uuid
  name                   String                @unique @db.VarChar(100)
  kind                   UndertimePolicyKind
  blockMinutes           Int?                  @map("block_minutes")
  amountPerBlockCentavos Int?                  @map("amount_per_block_centavos")
  /// FIXED_PER_BLOCK: a started block counts as a whole block.
  chargePartialBlock     Boolean               @default(true) @map("charge_partial_block")
  /// TIERED: [{ upToMinutes, amountCentavos }] in ascending order (validated by the API).
  tiers                  Json?
  isDefault              Boolean               @default(false) @map("is_default")
  isActive               Boolean               @default(true) @map("is_active")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles               CompensationProfile[]

  @@map("undertime_policy")
}

enum OvertimeRateKind {
  /// Hourly rate × multiplier (per mille: 1250 = 1.25×).
  MULTIPLIER
  /// A fixed amount per overtime hour.
  FIXED

  @@map("overtime_rate_kind")
}

enum PaySchedule {
  SEMI_MONTHLY
  ROLLING_15_DAY
  MONTHLY

  @@map("pay_schedule")
}

/// An employee's pay terms from a date onwards. Append-only: a change is a new version, so past
/// payrolls stay reproducible. Only versions that have not started yet may be removed.
model CompensationProfile {
  id                         String           @id @default(uuid()) @db.Uuid
  employeeId                 String           @map("employee_id") @db.Uuid
  employee                   Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  effectiveFrom              DateTime         @map("effective_from") @db.Date
  hourlyRateCentavos         Int              @map("hourly_rate_centavos")
  overtimeRateKind           OvertimeRateKind @map("overtime_rate_kind")
  overtimeMultiplierPermille Int?             @map("overtime_multiplier_permille")
  overtimeFixedRateCentavos  Int?             @map("overtime_fixed_rate_centavos")
  undertimePolicyId          String           @map("undertime_policy_id") @db.Uuid
  undertimePolicy            UndertimePolicy  @relation(fields: [undertimePolicyId], references: [id], onDelete: Restrict)
  paySchedule                PaySchedule      @map("pay_schedule")
  note                       String?          @db.VarChar(500)
  createdById                String           @map("created_by_id") @db.Uuid
  createdAt                  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([employeeId, effectiveFrom])
  @@map("compensation_profile")
}

enum PayItemDirection {
  ALLOWANCE
  DEDUCTION

  @@map("pay_item_direction")
}

enum PayItemCalculation {
  /// The same amount every payroll.
  FIXED
  /// A share of gross pay (basis points: 450 = 4.5%).
  PERCENT_OF_GROSS

  @@map("pay_item_calculation")
}

/// Kinds of recurring allowances and deductions (SSS, PhilHealth, Pag-IBIG, tax, loans…; Q-2).
model PayItemType {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique @db.VarChar(20)
  name      String            @unique @db.VarChar(100)
  direction PayItemDirection
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     EmployeePayItem[]

  @@map("pay_item_type")
}

/// An allowance or deduction applied to every payroll of one employee between two dates.
model EmployeePayItem {
  id              String             @id @default(uuid()) @db.Uuid
  employeeId      String             @map("employee_id") @db.Uuid
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  typeId          String             @map("type_id") @db.Uuid
  type            PayItemType        @relation(fields: [typeId], references: [id], onDelete: Restrict)
  calculation     PayItemCalculation
  amountCentavos  Int?               @map("amount_centavos")
  rateBasisPoints Int?               @map("rate_basis_points")
  effectiveFrom   DateTime           @map("effective_from") @db.Date
  /// Inclusive; null = until further notice.
  effectiveTo     DateTime?          @map("effective_to") @db.Date
  note            String?            @db.VarChar(500)
  version         Int                @default(1)
  createdById     String             @map("created_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([employeeId, effectiveFrom])
  @@map("employee_pay_item")
}
