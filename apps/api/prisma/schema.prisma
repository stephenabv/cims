// CIMS database schema. Conventions: snake_case tables/columns, UUID primary keys,
// created_at/updated_at on every mutable table, timestamptz for instants.
// See docs/SYSTEM_ARCHITECTURE.md §4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Access control ─────────────────────────────

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(500)
  /// System roles cannot be deleted or renamed (their permissions remain editable).
  isSystem    Boolean          @default(false) @map("is_system")
  /// Holders must enrol and use TOTP 2FA (spec §3.9, §5).
  requiresMfa Boolean          @default(false) @map("requires_mfa")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions RolePermission[]
  users       UserAccount[]

  @@map("role")
}

model Permission {
  code        String           @id @db.VarChar(100)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(100)
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@index([permissionCode])
  @@map("role_permission")
}

// ───────────────────────────── Organisation ─────────────────────────────

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(20)
  name      String     @unique @db.VarChar(100)
  /// Executive/manager responsible for the department (scopes `*.department` permissions).
  headId    String?    @map("head_id") @db.Uuid
  head      Employee?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  employees Employee[] @relation("DepartmentMembers")
  positions Position[]

  @@map("department")
}

model Position {
  id           String      @id @default(uuid()) @db.Uuid
  title        String      @db.VarChar(100)
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  employees    Employee[]

  @@unique([title, departmentId])
  @@map("position")
}

enum EmploymentClassification {
  REGULAR
  PROBATIONARY
  CONTRACTUAL
  PROJECT_BASED
  PART_TIME
  INTERN

  @@map("employment_classification")
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  RETIRED

  @@map("employment_status")
}

model Employee {
  id                           String                   @id @default(uuid()) @db.Uuid
  /// Permanent, system-assigned identifier (EMP-000123). Never editable (BR-1).
  accountNumber                String                   @unique @map("account_number") @db.VarChar(20)
  firstName                    String                   @map("first_name") @db.VarChar(100)
  middleName                   String?                  @map("middle_name") @db.VarChar(100)
  lastName                     String                   @map("last_name") @db.VarChar(100)
  suffix                       String?                  @db.VarChar(20)
  /// Approved company email only (BR-6). Stored lower-case.
  companyEmail                 String                   @unique @map("company_email") @db.VarChar(254)
  contactNumber                String?                  @map("contact_number") @db.VarChar(30)
  residentialAddress           String?                  @map("residential_address") @db.VarChar(500)
  emergencyContactName         String?                  @map("emergency_contact_name") @db.VarChar(200)
  emergencyContactRelationship String?                  @map("emergency_contact_relationship") @db.VarChar(50)
  emergencyContactPhone        String?                  @map("emergency_contact_phone") @db.VarChar(30)
  departmentId                 String?                  @map("department_id") @db.Uuid
  department                   Department?              @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  positionId                   String?                  @map("position_id") @db.Uuid
  position                     Position?                @relation(fields: [positionId], references: [id], onDelete: SetNull)
  /// Immediate supervisor / designated approver (§3.3).
  supervisorId                 String?                  @map("supervisor_id") @db.Uuid
  supervisor                   Employee?                @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates                 Employee[]               @relation("Supervision")
  classification               EmploymentClassification @default(PROBATIONARY)
  employmentStatus             EmploymentStatus         @default(ACTIVE) @map("employment_status")
  dateHired                    DateTime                 @map("date_hired") @db.Date
  /// Optimistic concurrency token.
  version                      Int                      @default(1)
  createdById                  String?                  @map("created_by_id") @db.Uuid
  createdAt                    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  account                      UserAccount?
  headOfDepartments            Department[]             @relation("DepartmentHead")
  changeHistory                EmployeeChangeHistory[]

  @@index([departmentId])
  @@index([supervisorId])
  @@index([lastName, firstName])
  @@map("employee")
}

model EmployeeChangeHistory {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  field       String   @db.VarChar(100)
  oldValue    String?  @map("old_value") @db.Text
  newValue    String?  @map("new_value") @db.Text
  changedById String?  @map("changed_by_id") @db.Uuid
  reason      String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([employeeId, createdAt])
  @@map("employee_change_history")
}

// ───────────────────────────── Accounts & sessions ─────────────────────────────

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

model UserAccount {
  id                    String            @id @default(uuid()) @db.Uuid
  employeeId            String            @unique @map("employee_id") @db.Uuid
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  roleId                String            @map("role_id") @db.Uuid
  role                  Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status                AccountStatus     @default(PENDING_ACTIVATION)
  passwordHash          String            @map("password_hash") @db.VarChar(255)
  passwordChangedAt     DateTime          @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  mustChangePassword    Boolean           @default(true) @map("must_change_password")
  /// Set while the current password is a temporary one (BR-7).
  tempPasswordExpiresAt DateTime?         @map("temp_password_expires_at") @db.Timestamptz(3)
  failedLoginCount      Int               @default(0) @map("failed_login_count")
  lockedUntil           DateTime?         @map("locked_until") @db.Timestamptz(3)
  lastLoginAt           DateTime?         @map("last_login_at") @db.Timestamptz(3)
  pinHash               String            @map("pin_hash") @db.VarChar(255)
  pinChangedAt          DateTime          @default(now()) @map("pin_changed_at") @db.Timestamptz(3)
  failedPinCount        Int               @default(0) @map("failed_pin_count")
  pinLockedUntil        DateTime?         @map("pin_locked_until") @db.Timestamptz(3)
  /// AES-256-GCM encrypted TOTP secret (base64 iv:tag:ciphertext).
  mfaSecretEnc          String?           @map("mfa_secret_enc") @db.VarChar(512)
  mfaEnabledAt          DateTime?         @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time-step; prevents replay of the same code.
  mfaLastStep           BigInt?           @map("mfa_last_step")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions              Session[]
  resetTokens           PasswordResetToken[]
  recoveryCodes         MfaRecoveryCode[]
  authEvents            AuthEvent[]

  @@index([roleId])
  @@map("user_account")
}

model Session {
  id            String      @id @default(uuid()) @db.Uuid
  /// SHA-256 of the opaque cookie token; the raw token is never stored.
  tokenHash     String      @unique @map("token_hash") @db.Char(64)
  userId        String      @map("user_id") @db.Uuid
  user          UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// False while a password-authenticated session still awaits the 2FA step.
  mfaVerified   Boolean     @default(false) @map("mfa_verified")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry regardless of activity.
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?     @map("revoked_reason") @db.VarChar(100)
  ip            String?     @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.VarChar(512)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model PasswordResetToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?   @map("used_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_token")
}

model MfaRecoveryCode {
  id       String      @id @default(uuid()) @db.Uuid
  userId   String      @map("user_id") @db.Uuid
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String      @map("code_hash") @db.Char(64)
  usedAt   DateTime?   @map("used_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("mfa_recovery_code")
}

// ───────────────────────────── Audit ─────────────────────────────

enum AuthEventType {
  LOGIN
  LOGOUT
  MFA_CHALLENGE
  MFA_ENROLLED
  MFA_DISABLED
  PASSWORD_CHANGED
  PASSWORD_RECOVERY_REQUESTED
  PASSWORD_RECOVERY_COMPLETED
  TEMP_PASSWORD_ISSUED
  PIN_CHANGED
  PIN_RESET
  ACCOUNT_LOCKED
  PIN_VERIFY
  SESSION_REVOKED

  @@map("auth_event_type")
}

model AuthEvent {
  id            String        @id @default(uuid()) @db.Uuid
  type          AuthEventType
  success       Boolean
  userId        String?       @map("user_id") @db.Uuid
  user          UserAccount?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Identifier as typed by the requester (kept even when no account matches).
  accountNumber String?       @map("account_number") @db.VarChar(50)
  reason        String?       @db.VarChar(100)
  ip            String?       @db.VarChar(64)
  userAgent     String?       @map("user_agent") @db.VarChar(512)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([accountNumber, createdAt])
  @@map("auth_event")
}

/// Append-only log of sensitive actions. Never contains secrets.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?  @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ───────────────────────────── Settings ─────────────────────────────

/// Typed key/value company configuration; keys and value schemas are defined in SettingsService.
model CompanySetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("company_setting")
}
